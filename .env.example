# =============================================================
# UCR Sales Funnel — Environment Variables
# =============================================================
# Setup di laptop baru:
#   1. cp .env.example .env.local
#   2. Isi nilai di bawah dari Supabase Dashboard
#      → Project Settings → API (project: mtpzxtqalqqghwokqkkf)
#   3. JANGAN commit .env.local (sudah di-gitignore)
# =============================================================

# URL project Supabase — Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://mtpzxtqalqqghwokqkkf.supabase.co

# Anon/public key — Settings → API → Project API keys → anon public
# Aman di-expose ke browser (dibatasi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — Settings → API → Project API keys → service_role
# ⚠️ RAHASIA — bypass RLS, hanya dipakai di server. JANGAN expose ke client.
SUPABASE_SERVICE_ROLE_KEY=
